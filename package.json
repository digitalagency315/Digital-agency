{
  "name": "growzone-whatsapp-agent",
  "version": "1.0.0",
  "private": true,
  "description": "GrowZone Media WhatsApp AI agent (WhatsApp Cloud API + Claude API)",
  "main": "dist/src/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node --env-file=.env dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "export-leads": "npm run build && node dist/scripts/export-leads.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.3"
  }
}
