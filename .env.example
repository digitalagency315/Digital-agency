# ------------------------------------------------------------------
# Copy to .env only for local testing. On Render, put these in the
# service's Environment tab. NEVER commit real values, never paste
# tokens in any chat.
# ------------------------------------------------------------------

PORT=3000
# Persistent folder for store.json + leads.jsonl (Render disk mount path)
DATA_DIR=./data
# BUSINESS_FILE=./business.md

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=            # System user permanent token
WHATSAPP_PHONE_NUMBER_ID=  # Phone number ID (not the phone number)
WHATSAPP_VERIFY_TOKEN=     # Any long random string; same value in Meta webhook settings
WHATSAPP_APP_SECRET=       # Meta App > Settings > Basic > App secret
# GRAPH_API_VERSION=v21.0
# Optional approved UTILITY template for owner alerts (1 body variable {{1}})
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANG=en

# ---- Owner ----
OWNER_NUMBER=91XXXXXXXXXX  # digits only, with country code; must NOT be the bot number

# ---- Claude API ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high  (low = fast + cheap, good for chat)
CLAUDE_EFFORT=low
# on | off  server-side refusal fallback
CLAUDE_FALLBACKS=on

# ---- Google Calendar (service account) ----
# base64 of the whole service-account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=digitalagency315@gmail.com
# 0=Sun ... 6=Sat (IST). Default Mon-Fri
WORKING_DAYS=1,2,3,4,5

# ---- UPI (course ₹999) ----
UPI_ID=yourname@okaxis
UPI_NAME=GrowZone Media
COURSE_PRICE=999
# Message sent to customer after you reply "PAID <number>" (e.g. course access link)
COURSE_ACCESS_MESSAGE=

# ---- Optional email alerts (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# LOG_LEVEL=info
